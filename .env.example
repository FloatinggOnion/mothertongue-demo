# LLM backbone for chat, evaluation, suggestions, level assessment.
# 'gemini' (default) or 'groq' — see src/services/llm.ts
LLM_PROVIDER=gemini

# Groq (used when LLM_PROVIDER=groq)
GROQ_API_KEY=

# Gemini on Vertex AI (used when LLM_PROVIDER=gemini, the default).
# Model defaults to gemini-2.5-pro; override with GEMINI_MODEL, e.g. gemini-3.1-pro-preview.
GEMINI_MODEL=
GOOGLE_CLOUD_LOCATION=us-central1

# Google Cloud (STT for Yoruba + Hausa via Chirp, TTS for Yoruba, and Gemini
# on Vertex AI — the same service account covers all three)
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_CLOUD_PROJECT=

# Intron (TTS for Hausa)
INTRON_API_KEY=

# Morena 1.5B on Modal (used when LLM_PROVIDER=morena for getPartnerResponse)
# Use a dedicated Modal account without disturbing your global ~/.modal.toml:
#   1. Create the new account at modal.com, copy its token ID + secret
#   2. Fill in the two vars below
#   3. Run: bash scripts/deploy_morena.sh
#   4. Paste the printed endpoint URL into MORENA_MODAL_URL
MODAL_TOKEN_ID_MORENA=
MODAL_TOKEN_SECRET_MORENA=
MORENA_MODAL_URL=
# Shared secret between Next.js and the Modal endpoint — generate any random string.
# Modal reads this from .env.local at deploy time; morena.ts sends it as X-Api-Key.
MORENA_ENDPOINT_SECRET=
