# LLM backbone for chat, evaluation, suggestions, level assessment.
# 'gemini' (default), 'groq', 'morena', 'aya' or 'hybrid' — see src/services/llm.ts.
# 'hybrid' = Tiny Aya for Hausa and Igbo partner replies, Gemini for Yoruba and the rest.
LLM_PROVIDER=gemini

# Clerk account (optional for local practice; required to save progress)
# In the existing Clerk app, enable email verification codes for sign-up and
# sign-in, then disable password, email link, phone, and social sign-in methods.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Optional web measurement. Create a free PostHog project, then enable only
# after reviewing the privacy notice. Events contain no conversation text.
POSTHOG_PROJECT_KEY=
POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_ANALYTICS_ENABLED=false

# Optional adult-only conversation review. First run the SQL migration in
# neon/migrations. Use a Neon pooled connection string, server-side only.
NEON_DATABASE_URL=
NEXT_PUBLIC_RESEARCH_SHARING_ENABLED=false
# Vercel sends this to the daily deletion cron as a Bearer token.
CRON_SECRET=
# Privacy contact shown on /privacy. Defaults to the founder's supplied inbox.
PRIVACY_CONTACT_EMAIL=

# Groq (used when LLM_PROVIDER=groq)
GROQ_API_KEY=

# Gemini on Vertex AI (used when LLM_PROVIDER=gemini, the default).
# Model defaults to gemini-2.5-pro; override with GEMINI_MODEL, e.g. gemini-3.1-pro-preview.
GEMINI_MODEL=
GOOGLE_CLOUD_LOCATION=us-central1

# Google Cloud (STT for Yoruba + Hausa via Chirp, TTS for Yoruba, and Gemini
# on Vertex AI — the same service account covers all three)
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_CLOUD_PROJECT=

# Intron (TTS for Hausa)
INTRON_API_KEY=

# Morena 1.5B on Modal (used when LLM_PROVIDER=morena for getPartnerResponse)
# Use a dedicated Modal account without disturbing your global ~/.modal.toml:
#   1. Create the new account at modal.com, copy its token ID + secret
#   2. Fill in the two vars below
#   3. Run: bash scripts/deploy_morena.sh
#   4. Paste the printed endpoint URL into MORENA_MODAL_URL
MODAL_TOKEN_ID_MORENA=
MODAL_TOKEN_SECRET_MORENA=
MORENA_MODAL_URL=
# Shared secret between Next.js and the Modal endpoint — generate any random string.
# Modal reads this from .env.local at deploy time; morena.ts sends it as X-Api-Key.
MORENA_ENDPOINT_SECRET=

# Cohere Tiny Aya (used when LLM_PROVIDER=aya or hybrid for getPartnerResponse).
# Commercial use needs a paid production key; trial keys are for evaluation.
COHERE_API_KEY=
# Optional override; defaults to tiny-aya-earth (tuned for African languages)
COHERE_PARTNER_MODEL=
